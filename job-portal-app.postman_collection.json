        {
          "name": "Get Profile - Invalid Token (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobseeker-api/profile",
            "header": [
              {
                "key": "Cookie",
                "value": "accessToken=not.a.valid.jwt"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 invalid token', () => pm.response.to.have.status(401));"
