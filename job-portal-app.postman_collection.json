        },
        {
          "name": "Update Own Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobseeker-api/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"experience\": \"1.5 years, now including MongoDB aggregation pipelines\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Job Seeker - Create Job (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/employer-api/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Fail\",\n  \"companyName\": \"N/A\",\n  \"description\": \"N/A\",\n  \"location\": \"N/A\",\n  \"employmentType\": \"FULL_TIME\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403 forbidden for jobseeker', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Browse All Open Jobs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobseeker-api/jobs"
          }
        },
        {
          "name": "View Single Job By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobseeker-api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Apply For Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobseeker-api/jobs/{{jobId}}/apply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverLetter\": \"I would love to build this API!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('applicationId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Apply Again - Duplicate (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/jobseeker-api/jobs/{{jobId}}/apply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"coverLetter\": \"Trying again\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 duplicate application', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "View My Applications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobseeker-api/applications"
          }
        },
        {
          "name": "View My Application Status By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobseeker-api/applications/{{applicationId}}"
          }
        },
        {
          "name": "Logout Job Seeker",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth-api/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Access Profile After Logout (expect 401)",
          "request": {
            "method": "GET",
