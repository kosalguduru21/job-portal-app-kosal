    {
      "name": "5. Admin Flow",
      "item": [
        {
          "name": "Register Admin (self-register, then promote manually)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth-api/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Platform Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Registers as JOBSEEKER via the public endpoint (self-registration can never create ADMIN). In a real deployment, open Mongo shell/Compass and set role:'ADMIN' for this user manually."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth-api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Non-Admin Tries Admin Route (expect 403 before promotion)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin-api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403 before role is promoted', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Users (after manual promotion to ADMIN in db)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin-api/users"
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin-api/users/{{jobseekerUserId}}"
          }
        },
        {
          "name": "Deactivate a User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin-api/users/{{jobseekerUserId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivated User Tries To Login (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth-api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{jobseekerEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403 deactivated account', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reactivate a User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin-api/users/{{jobseekerUserId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Get All Job Postings (any status)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin-api/jobs"
          }
        },
        {
          "name": "Get Job Posting By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin-api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Remove Inappropriate Job Posting",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin-api/jobs/{{jobId}}"
          }
        },
        {
          "name": "Delete a User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin-api/users/{{jobseekerUserId}}"
          }
        }
      ]
    }
  ]
}