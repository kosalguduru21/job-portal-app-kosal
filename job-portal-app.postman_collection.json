    {
      "name": "4. Cross-User Authorization Tests",
      "item": [
        {
          "name": "Register Second Employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth-api/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Other Employer\",\n  \"email\": \"employer2@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"EMPLOYER\"\n}"
            }
          }
        },
        {
          "name": "Login Second Employer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth-api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employer2@example.com\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Second Employer Tries To Update First Employer's Job (expect 401)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/employer-api/jobs/{{jobId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hijacked title\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 forbidden', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Second Employer Tries To View First Employer's Applications (expect 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/employer-api/jobs/{{jobId}}/applications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 forbidden', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
